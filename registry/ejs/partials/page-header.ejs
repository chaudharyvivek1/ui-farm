<%#
  Page header
  locals: title, subtitle, actions (html)
%>
<header class="uif-page-header">
  <div>
    <h1 class="uif-page-header__title"><%= locals.title || 'Page' %></h1>
    <% if (locals.subtitle) { %><p class="uif-page-header__sub"><%= locals.subtitle %></p><% } %>
  </div>
  <% if (locals.actions) { %><div class="uif-page-header__actions"><%- locals.actions %></div><% } %>
</header>
